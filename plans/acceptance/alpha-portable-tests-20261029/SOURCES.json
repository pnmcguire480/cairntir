{
  "schema": "cairntir.portable-test-source.v1",
  "purpose": "Ordinary alpha CI test source; not a protected evaluator or historical qualification result.",
  "adaptations": [
    "Package-relative imports and current fixture paths replace historical packet loaders.",
    "Normal lint/formatting, equivalent dictionary/list syntax, strict equal-length zip and bound immediate loop callbacks.",
    "Recall transport retains a 5600-character no-hit query under a 1024-character response budget; the original 105000-character query separately verifies the existing 6000-character input-window refusal.",
    "Assertion diagnostics expose the actual recall error receipt.",
    "The two angle supplement loader-existence assertions are replaced by ordinary package imports; behavioral assertions remain.",
    "Synthetic print assets retain original bytes; the surrogate test reads the copied sibling fixture.",
    "Human-review controls use the same controlled PALADIN fixture through an ordinary import.",
    "Two exact XML-parser lint annotations cover only locally generated synthetic artifact payloads.",
    "Controlled Codex wire tests retain exact original helper bytes and SHA guards; only the test and non-model peer are formatted.",
    "The controlled Python version observation, recorded argv, executable binding and bytes hash use one resolved path, preserving strict identity checks across virtual-environment symlinks."
  ],
  "scope": "Synthetic stores, controlled reports and images. Real tools, live browser efficacy and native host readiness are separate gates.",
  "excluded": [
    "Private historical project/source records and machine paths bound into channel/outline/calendar test packets.",
    "Prepared real-tool wheelhouses, machine inventories, private packet loaders, raw local receipts and archived controls."
  ],
